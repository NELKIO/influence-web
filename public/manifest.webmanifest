{
  "name": "Influence Web",
  "short_name": "Influence",
  "description": "Turn-based territory strategy in the browser",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0c0f",
